# Copie para .env.local e preencha. Usado pelo formulário de /contato.
# Chave em https://resend.com/api-keys
RESEND_API_KEY=
# E-mail que recebe as mensagens
CONTACT_TO_EMAIL=
# Remetente (opcional). Precisa ser de um domínio verificado no Resend.
# Sem domínio próprio, use o padrão de testes abaixo.
CONTACT_FROM_EMAIL="Portfólio <onboarding@resend.dev>"
